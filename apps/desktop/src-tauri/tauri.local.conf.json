{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cap 本地版",
	"version": "0.6.1",
	"mainBinaryName": "Cap Local",
	"identifier": "local.cap.desktop.zh",
	"build": {
		"beforeBuildCommand": "pnpm build"
	},
	"plugins": {
		"updater": {
			"active": false,
			"pubkey": ""
		},
		"deep-link": {
			"desktop": {
				"schemes": ["cap-local"]
			}
		}
	},
	"bundle": {
		"createUpdaterArtifacts": false,
		"resources": {
			"icons/local-windows/icon.ico": "Cap Local.ico"
		},
		"icon": [
			"icons/local-windows/32x32.png",
			"icons/local-windows/128x128.png",
			"icons/local-windows/128x128@2x.png",
			"icons/macos/icon.icns",
			"icons/local-windows/icon.ico"
		],
		"macOS": {
			"signingIdentity": "-",
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"nsis": {
				"installerIcon": "icons/local-windows/icon.ico",
				"languages": ["SimpChinese"],
				"displayLanguageSelector": false
			},
			"wix": {
				"version": "0.6.1",
				"language": "zh-CN",
				"upgradeCode": "e31b1c9b-1480-4d26-8294-4b1e97e416c4"
			}
		}
	}
}
